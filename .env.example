# TRAZZO — variables de entorno
# Copia este archivo a .env.local para desarrollo. En Vercel, configura las
# mismas variables desde Project Settings → Environment Variables.

# ── Obligatorias para producción: Supabase ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Correos propietarios separados por comas. NEXT_PUBLIC se incluye en la app web.
NEXT_PUBLIC_TRAZZO_OWNER_EMAILS=
# Lista adicional de correos para el acceso de propietario en la API de chat.
TRAZZO_OWNER_EMAILS=

# ── Opcionales: pagos web (Mercado Pago / Culqi) ─────────────────────────────
# Mercado Pago habilita checkout y webhooks cuando ambas variables existen.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Culqi requiere la clave pública para tokenizar en web, la secreta para el
# servidor y el secreto de firma del webhook.
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_WEBHOOK_SECRET=
# URL pública de Vercel para retornos del checkout y notificaciones.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Opcionales: IA ──────────────────────────────────────────────────────────
# Se usa el primer proveedor disponible si AI_PROVIDER está vacío.
AI_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Cupo diario de IA generativa. Los visitantes comparten el límite Free.
AI_DAILY_LIMIT_FREE=5
AI_DAILY_LIMIT_PRO=40

# ── Opcional: compilación nativa con Capacitor ───────────────────────────────
# En producción: https://tu-proyecto.vercel.app
# En desarrollo puede omitirse para usar las páginas locales de capacitor/www.
CAPACITOR_SERVER_URL=
